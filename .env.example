# Base URL for loading existing cephalometry data via ?appointment_id= URL param.
# Leave unset for standard open-source usage.
VITE_CEPHALOMETRY_LOAD_URL=https://drghartanto.com

# Upload/reset API target. When set, the "Simpan Hasil" and "Mulai Ulang" buttons appear.
# Can differ from VITE_CEPHALOMETRY_LOAD_URL if the upload service runs on a separate domain.
VITE_CLINIC_API_URL=https://drghartanto.com
